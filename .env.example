# Qui Browser VR - Environment Configuration
# Copy this file to .env. Every variable below is actually read by the code —
# anything not listed here does nothing.

# ---------------------------------------------------------------------------
# App (Vite build-time variables — must be set before `npm run build`)
# ---------------------------------------------------------------------------


# Google Analytics 4 measurement ID (src/monitoring.js). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Reported in monitoring payloads (optional; defaults are fine)
VITE_APP_VERSION=2.0.0
VITE_BUILD_TIME=

# ---------------------------------------------------------------------------
# Reader proxy (proxy/server.js, started via `npm run proxy`)
# ---------------------------------------------------------------------------

# HTTP port the proxy listens on
PORT=8080

# Comma-separated list of origins allowed to call the proxy (CORS).
# Defaults to '*' — restrict this in production.
ALLOW_ORIGIN=*
