# Qui Browser VR — client env config (Vite only exposes VITE_* vars).
# Copy to `.env` to override; every variable is optional.

# Sentry DSN for monitoring.js error reporting (unset = no-op init)
VITE_SENTRY_DSN=

# Google Analytics 4 measurement ID (unset = analytics disabled)
VITE_GA_MEASUREMENT_ID=

# Version string stamped into the app (defaults to package.json version)
VITE_APP_VERSION=

# Build timestamp stamped into the app (defaults to build time)
VITE_BUILD_TIME=
