# Qui Browser VR - Environment Configuration
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Application
VR_BROWSER_VERSION=5.7.0
VR_BROWSER_NAME="Qui Browser VR"

# Performance Targets
VR_DEFAULT_FPS_TARGET=90
VR_MIN_FPS_TARGET=72
VR_FRAME_TIME_BUDGET=11.1

# Memory Management
VR_MEMORY_LIMIT_MB=2048
VR_MEMORY_WARNING_MB=1800
VR_MEMORY_CRITICAL_MB=1950

# Default Settings
DEFAULT_ENVIRONMENT=space
DEFAULT_UI_LAYOUT=comfortable
DEFAULT_HAND_TRACKING=true
DEFAULT_EYE_TRACKING=true
DEFAULT_FOVEATED_RENDERING=auto

# Logging
DEBUG_MODE=false
LOG_LEVEL=info

# Features
ENABLE_ML_GESTURES=true
ENABLE_SPATIAL_ANCHORS=true
ENABLE_NEURAL_RENDERING=true
ENABLE_EYE_TRACKING=true
ENABLE_BODY_IK=true

# Performance
ENABLE_FOVEATED_RENDERING=true
ENABLE_OBJECT_POOLING=true
ENABLE_MEMORY_OPTIMIZATION=true
ENABLE_PERFORMANCE_MONITORING=true

# ============================================================================
# Backend server (server/index.js, started via `npm run start:server`)
# ============================================================================

# HTTP port the Express server listens on
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL used to build Stripe success/cancel/return redirect links
BASE_URL=http://localhost:5173

# Stripe (server/stripe-billing.js). Leave STRIPE_SECRET_KEY unset/placeholder
# to run the server without billing — /api/billing/* returns 503 instead of
# failing deep inside the Stripe SDK.
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Price IDs for each paid plan (create these in the Stripe Dashboard first)
STRIPE_PRICE_PREMIUM_MONTHLY_JPY=price_YOUR_PREMIUM_MONTHLY_ID
STRIPE_PRICE_PREMIUM_YEARLY_JPY=price_YOUR_PREMIUM_YEARLY_ID
STRIPE_PRICE_BUSINESS_MONTHLY_JPY=price_YOUR_BUSINESS_MONTHLY_ID
STRIPE_PRICE_BUSINESS_YEARLY_JPY=price_YOUR_BUSINESS_YEARLY_ID
