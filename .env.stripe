# SUPERSEDED — this described the abandoned "Chrome extension" pricing model
# (api/stripe-payment.js, not mounted anywhere). The canonical server config
# is now in .env.example (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_* for server/stripe-billing.js's real JPY-tiered plans,
# started via `npm run start:server`). Kept only as historical reference.
#
# Stripe Configuration for Chrome Extension Feature
# Chrome拡張機能の課金設定

# Stripe API Keys (Replace with your actual keys)
# Stripeダッシュボードから取得: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Price IDs (Create these in Stripe Dashboard)
# 価格IDはStripeダッシュボードで作成
PRICE_SUBSCRIPTION_ID=price_subscription_50cents_monthly
PRICE_LIFETIME_ID=price_lifetime_150cents_onetime

# Server Configuration
PORT=3000
API_BASE_URL=http://localhost:3000

# Production URLs — replace with your actual deployed domain(s); the
# placeholders below intentionally use the RFC 2606 reserved .example TLD
# so they can never resolve to a real (and possibly unrelated) site.
PRODUCTION_URL=https://your-domain.example
PRODUCTION_API_URL=https://api.your-domain.example