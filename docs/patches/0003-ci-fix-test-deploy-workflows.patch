+      - name: Build
+        run: npm run build
+        env:
+          # GitHub Pages serves the site under /<repo-name>/ — vite.config.js
+          # maps BASE_PATH onto `base` for this build only.
+          BASE_PATH: /Qui-Browser/
 
       - name: Create build info
         run: |
@@ -56,7 +49,7 @@ jobs:
             \"build\": \"${{ github.sha }}\",
             \"date\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",
             \"branch\": \"${{ github.ref_name }}\"
-          }" > build-info.json
