From 7edfbc868f9d5e7f57ba784275d99621555652ed Mon Sep 17 00:00:00 2001
From: Devin <devin@cognition.ai>
Date: Sun, 20 Sep 2026 17:41:39 -0700
Subject: [PATCH] ci: fix two jobs pointing at deleted code
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

test-integration ran jest against tests/tier-system-integration.test.js,
deleted long ago — npm test exits nonzero with no tests found, so this
job fails on every main push / PR-to-main. Repoint to the real suite
alias: npm run test:integration (jest tests/vr-app-wiring.test.js
tests/app-smoke.test.js, wired in the test:integration fix).

test-performance ran 'npm run benchmark:all' — the benchmark pipeline
(tools/benchmark.js, tools/check-performance-regression.js, the script,
the measured assets/js/vr-*.js files) was deleted wholesale. The job
fails immediately. Deleted the job and its needs/summary references.

Co-Authored-By: うめ <app.shizukutanaka@gmail.com>
---
 .github/workflows/ci.yml | 41 ++--------------------------------------
 1 file changed, 2 insertions(+), 39 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 7e514a4..688951b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -122,7 +122,7 @@ jobs:
         run: npm ci
 
       - name: Run tier system integration tests
-        run: npm test -- tests/tier-system-integration.test.js --maxWorkers=2
+        run: npm run test:integration -- --maxWorkers=2
 
       - name: Upload test results
         uses: actions/upload-artifact@v4
@@ -132,42 +132,6 @@ jobs:
           path: test-results/
           retention-days: 30
 
-  # ============================================================================
-  # JOB 4: Performance Tests
-  # ============================================================================
-  test-performance:
-    name: Performance Tests
-    runs-on: ubuntu-latest
-    timeout-minutes: 20
-
-    steps:
-      - name: Checkout code
-        uses: actions/checkout@v4
-
-      - name: Setup Node.js
-        uses: actions/setup-node@v4
-        with:
-          node-version: ${{ env.NODE_VERSION }}
-          cache: 'npm'
-
-      - name: Install dependencies
-        run: npm ci
-
-      - name: Run benchmark tests
-        run: npm run benchmark:all -- --iterations 100 --output benchmark-results.json --format json
-
-      - name: Check performance regression
-        run: |
-          node tools/check-performance-regression.js benchmark-results.json
-        continue-on-error: true
-
-      - name: Upload benchmark results
-        uses: actions/upload-artifact@v4
-        with:
-          name: benchmark-results
-          path: benchmark-results.json
-          retention-days: 90
-
   # ============================================================================
   # JOB 5: Build Verification
   # ============================================================================
@@ -339,7 +303,7 @@ jobs:
   summary:
     name: CI Summary
     runs-on: ubuntu-latest
-    needs: [lint, test-unit, test-integration, test-performance, build, lighthouse, docker, security]
+    needs: [lint, test-unit, test-integration, build, lighthouse, docker, security]
     if: always()
 
     steps:
@@ -352,7 +316,6 @@ jobs:
           echo "| Lint | ${{ needs.lint.result }} |" >> $GITHUB_STEP_SUMMARY
           echo "| Unit Tests | ${{ needs.test-unit.result }} |" >> $GITHUB_STEP_SUMMARY
           echo "| Integration Tests | ${{ needs.test-integration.result }} |" >> $GITHUB_STEP_SUMMARY
-          echo "| Performance Tests | ${{ needs.test-performance.result }} |" >> $GITHUB_STEP_SUMMARY
           echo "| Build | ${{ needs.build.result }} |" >> $GITHUB_STEP_SUMMARY
           echo "| Lighthouse | ${{ needs.lighthouse.result }} |" >> $GITHUB_STEP_SUMMARY
           echo "| Docker | ${{ needs.docker.result }} |" >> $GITHUB_STEP_SUMMARY
-- 
2.50.1 (Apple Git-155)

